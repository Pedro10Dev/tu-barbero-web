{
  "providers": ["php"],
  "phases": {
    "setup": {
      "nixPkgs": ["php84", "php84Packages.composer", "nodejs_20"]
    },
    "install": {
      "cmds": [
        "composer install --optimize-autoloader --no-dev",
        "npm ci"
      ]
    },
    "build": {
      "cmds": [
        "npm run build"
      ]
    }
  }
}